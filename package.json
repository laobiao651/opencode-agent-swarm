{
  "name": "opencode-agent-swarm",
  "version": "1.1.2",
  "description": "OpenCode 多智能体编排插件 —— Task Build 主代理调度 8 个子代理协作完成复杂软件开发任务",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "opencode-agent-swarm": "./dist/cli/index.js"
  },
  "type": "module",
  "files": [
    "assets",
    "dist",
    "src/skills",
    "README.md"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "npx esbuild src/index.ts src/cli/index.ts --bundle --platform=node --format=esm --outdir=dist --external:@opencode-ai/plugin",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "agents",
    "orchestration",
    "swarm",
    "task-build",
    "multi-agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@opencode-ai/plugin": "^1.3.17"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}